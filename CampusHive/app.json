{
  "expo": {
    "name": "OnlyStudents",
    "slug": "onlystudent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "onlystudents",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1E3A5F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onlystudents.app"
    },
    "android": {
      "package": "com.onlystudents.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90d5ea49-08d7-46fa-87ee-f5700d8842e9"
      }
    },
    "owner": "happy14s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/90d5ea49-08d7-46fa-87ee-f5700d8842e9"
    }
  }
}