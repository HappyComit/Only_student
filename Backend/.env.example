# ==========================================
# OnlyStudents Backend — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase PostgreSQL Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase Storage & API
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Razorpay Payment Gateway (Get keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# SMTP Email (Gmail App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your_gmail_app_password"
